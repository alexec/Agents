      "$value": { "color": "#1a1918", "alpha": 0.18, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 12, "unit": "px" }, "blur": { "value": 32, "unit": "px" }, "spread": { "value": 0, "unit": "px" } },
      "$description": "Sheets and dialogs, over a dimmed page.",
      "$extensions": { "dev.agentloops.dark": { "color": "#000000", "alpha": 0.55 }, "dev.agentloops.swift": "Paper.Shadow.sheet" }
    }
