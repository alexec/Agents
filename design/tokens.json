      "$extensions": { "dev.agentloops.swift": "Paper.Radius.code" }
    },
    "control": {
      "$value": { "value": 7, "unit": "px" },
      "$description": "Chips, the rail, inputs.",
      "$extensions": { "dev.agentloops.swift": "Paper.Radius.control" }
    },
    "card": {
      "$value": { "value": 10, "unit": "px" },
      "$description": "Rows, wells, cards.",
      "$extensions": { "dev.agentloops.swift": "Paper.Radius.card" }
    },
    "floating": {
      "$value": { "value": 16, "unit": "px" },
      "$description": "Sheets, menus, the prompt bar (web)."
    },
    "pill": {
      "$value": { "value": 99, "unit": "px" },
      "$description": "A state badge: round ends.",
      "$extensions": { "dev.agentloops.swift": "Paper.Radius.pill" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "text": {
      "$value": ["Atkinson Hyperlegible Next", "-apple-system", "BlinkMacSystemFont", "system-ui", "sans-serif"],
      "$description": "Atkinson Hyperlegible Next (SIL OFL 1.1, design/fonts/), for everything a person reads; the system's sans-serif where it is not loaded. Nothing is loaded from another origin (#4975)."
    },
    "mono": {
      "$value": ["Atkinson Hyperlegible Mono", "ui-monospace", "SF Mono", "Menlo", "monospace"],
      "$description": "Atkinson Hyperlegible Mono (SIL OFL 1.1, design/fonts/), for code; the system's monospace where it is not loaded."
    }
  },
  "type": {
    "$type": "dimension",
    "$description": "A step is a place on each platform's own scale: dev.agentloops.mac and dev.agentloops.ios are SwiftUI text styles (TypeScale.swift), the $value is the web's size.",
    "title": {
      "$value": { "value": 1.375, "unit": "rem" },
      "$description": "A page's title.",
      "$extensions": { "dev.agentloops.mac": ".title", "dev.agentloops.ios": ".title" }
    },
    "reading": {
      "$value": { "value": 1, "unit": "rem" },
      "$description": "Prose: what everything is read at unless there is a reason otherwise.",
      "$extensions": { "dev.agentloops.mac": ".title3", "dev.agentloops.ios": ".body" }
    },
    "supporting": {
      "$value": { "value": 0.875, "unit": "rem" },
      "$description": "A row's second line.",
      "$extensions": { "dev.agentloops.mac": ".body", "dev.agentloops.ios": ".subheadline" }
    },
    "fine": {
      "$value": { "value": 0.75, "unit": "rem" },
      "$description": "A timestamp, a count.",
      "$extensions": { "dev.agentloops.mac": ".subheadline", "dev.agentloops.ios": ".footnote" }
    },
    "code": {
      "$value": { "value": 0.875, "unit": "rem" },
      "$description": "Code, paths, commands, in the monospace.",
      "$extensions": { "dev.agentloops.mac": ".body", "dev.agentloops.ios": ".subheadline" }
    },
    "display": {
      "1": {
        "$value": "clamp(2rem, 5vw, 3.2rem)",
        "$description": "www's hero title."
      },
      "2": {
        "$value": { "value": 1.8, "unit": "rem" },
        "$description": "www's section titles."
      }
    },
    "leading": {
      "$description": "Line height, as a multiple of the size (BDA style guide, WCAG 1.4.12).",
      "reading": {
        "$type": "number",
        "$value": 1.5,
        "$description": "Reading text: prose, messages.",
        "$extensions": { "dev.agentloops.swift": "TextStep.readingLeading" }
      }
    },
    "tracking": {
      "$description": "Letter spacing, in em.",
      "reading": {
        "$value": { "value": 0.01, "unit": "em" },
        "$description": "Reading text: a little letter spacing.",
        "$extensions": { "dev.agentloops.swift": "TextStep.readingTracking" }
      }
    },
    "word-spacing": {
      "$description": "Word spacing, in em.",
      "reading": {
        "$value": { "value": 0.06, "unit": "em" },
        "$description": "Reading text: a little word spacing.",
        "$extensions": { "dev.agentloops.swift": "none: SwiftUI has no word spacing" }
      }
