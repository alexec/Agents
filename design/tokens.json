{
  "$description": "The design system's values (#4600, #4602): Paper, the app's look (#326, #695). One source. scripts/design.sh gen writes the CSS token files from it; DesignTokensTests says what to change in Shared/UI/Paper.swift, StateTint.swift, TypeScale.swift and the AccentColor assets. W3C Design Tokens shape: a colour's $value is its light value, and dev.agentloops.dark is its dark one.",
  "color": {
    "$type": "color",
    "ground": {
      "$value": "#f7f8f9",
      "$description": "The page every column sits on.",
      "$extensions": { "dev.agentloops.dark": "#1c1d20", "dev.agentloops.swift": "Paper.ground" }
    },
    "sidebar": {
      "$value": "#f0f1f3",
      "$description": "The folders column, one shade deeper.",
      "$extensions": { "dev.agentloops.dark": "#161719", "dev.agentloops.swift": "Paper.sidebar" }
    },
    "raised": {
      "$value": "#ffffff",
      "$description": "What floats: the prompt bar, cards, menus.",
      "$extensions": { "dev.agentloops.dark": "#26282c", "dev.agentloops.swift": "Paper.raised" }
    },
    "well": {
      "$value": "#f0f2f4",
      "$description": "What is set into the page: code, your own message.",
      "$extensions": { "dev.agentloops.dark": "#2a2d31", "dev.agentloops.swift": "Paper.well" }
    },
    "wash": {
      "$value": "#e7eaee",
      "$description": "A row under the pointer, a picked item.",
      "$extensions": { "dev.agentloops.dark": "#33363b", "dev.agentloops.swift": "Paper.wash" }
    },
    "rule": {
      "$value": "#dde1e6",
      "$description": "Hairlines between rows, and round raised things.",
      "$extensions": { "dev.agentloops.dark": "#3a3e44", "dev.agentloops.swift": "Paper.rule" }
    },
    "ink": {
      "$value": "#1c1d20",
      "$description": "Text, and the prominent button's fill.",
      "$extensions": { "dev.agentloops.dark": "#e8eaed", "dev.agentloops.swift": "Paper.ink" }
    },
    "selection": {
      "$value": "#d8dee6",
      "$description": "A selection. Nothing is drawn in the accent on it.",
      "$extensions": { "dev.agentloops.dark": "#3a3e44", "dev.agentloops.swift": "paperSelection" }
    },
    "shadow": {
      "$value": "#20242a",
      "$description": "Under a raised thing: short and neutral, paper lifted a little off the desk.",
      "$extensions": { "dev.agentloops.dark": "#000000", "dev.agentloops.alpha": 0.1, "dev.agentloops.swift": "Paper.shadow" }
    },
    "accent": {
      "$value": "#1f5fc8",
      "$description": "The app icon's cobalt: links, focus, controls and the prominent button's fill.",
      "$extensions": { "dev.agentloops.dark": "#7fb0ff", "dev.agentloops.swift": "AccentColor.colorset" }
    },
    "tint": {
      "attention": {
        "$value": "#856a00",
        "$description": "Needs you: a question, a request, a wait only the person can settle; the only tint drawn in a list. Yellow, never the warning's orange (#5016).",
        "$extensions": { "dev.agentloops.dark": "#e6c04f", "dev.agentloops.swift": "StateTint.yellow" }
      },
      "warning": {
        "$value": "#ba4a13",
        "$description": "A warning: something is wrong or nearly so, and a person should know. Not a request (#5016).",
        "$extensions": { "dev.agentloops.dark": "#f0a06b", "dev.agentloops.swift": "StateTint.orange" }
      },
      "failure": {
        "$value": "#b4232b",
        "$description": "Failed.",
        "$extensions": { "dev.agentloops.dark": "#f08086", "dev.agentloops.swift": "StateTint.red" }
      },
      "vouched": {
        "$value": "#2d765c",
        "$description": "Approved, done: an ending the app can vouch for.",
        "$extensions": { "dev.agentloops.dark": "#8bc6a7", "dev.agentloops.swift": "StateTint.green" }
      }
    },
    "label": {
      "issue": {
        "$value": "#0e6b82",
        "$description": "A label naming an issue, #12.",
        "$extensions": { "dev.agentloops.dark": "#6cc6db", "dev.agentloops.swift": "Paper.issue" }
      },
      "pull": {
        "$value": "#7442b8",
        "$description": "A label naming a pull request, P#12.",
        "$extensions": { "dev.agentloops.dark": "#b79af0", "dev.agentloops.swift": "Paper.pull" }
      }
    },
    "on-fill": {
      "$value": "#ffffff",
      "$description": "What is drawn on a filled mark: a state's badge, a swipe's action.",
      "$extensions": { "dev.agentloops.dark": "#ffffff", "dev.agentloops.swift": "none: SwiftUI's Color.white" }
    },
    "scrim": {
      "$value": "#000000",
      "$description": "Behind a sheet or a viewer, mixed with transparent to the strength it needs.",
      "$extensions": { "dev.agentloops.dark": "#000000", "dev.agentloops.swift": "none: SwiftUI's Color.black" }
    },
    "forge": {
      "$description": "An issue's or a pull request's state as its forge draws it (WorkLook, specs/4328-work-look/parts.md section 1): GitHub's own hues, not the app's tints, so they never read as the app's state.",
      "open": {
        "$value": "#1a7f37",
        "$description": "Open; a check that passed; running.",
        "$extensions": { "dev.agentloops.dark": "#3fb950", "dev.agentloops.swift": "Paper.forgeOpen" }
      },
      "done": {
        "$value": "#8250df",
        "$description": "A closed issue, a merged pull request.",
        "$extensions": { "dev.agentloops.dark": "#a371f7", "dev.agentloops.swift": "Paper.forgeDone" }
      },
      "closed": {
        "$value": "#cf222e",
        "$description": "A pull request closed unmerged; a check that failed; changes asked for.",
        "$extensions": { "dev.agentloops.dark": "#f85149", "dev.agentloops.swift": "Paper.forgeClosed" }
      },
      "draft": {
        "$value": "#6e7781",
        "$description": "A draft, an issue not planned.",
        "$extensions": { "dev.agentloops.dark": "#8b949e", "dev.agentloops.swift": "Paper.forgeDraft" }
      },
      "waiting": {
        "$value": "#9a6700",
        "$description": "A check still running; an agent that waits on the person.",
        "$extensions": { "dev.agentloops.dark": "#d29922", "dev.agentloops.swift": "Paper.forgeWaiting" }
      },
      "waiting-wash": {
        "$value": "#fff8c5",
        "$description": "Under a notice in the forge's amber.",
        "$extensions": { "dev.agentloops.dark": "#2f2a1a", "dev.agentloops.swift": "Paper.forgeWaitingWash" }
      },
      "waiting-rule": {
        "$value": "#d4a72c",
        "$description": "The edge of a notice in the forge's amber.",
        "$extensions": { "dev.agentloops.dark": "#6b5a1e", "dev.agentloops.swift": "Paper.forgeWaitingRule" }
      },
      "mark": {
        "$value": "#212121",
        "$description": "The near-black disc under a connector's letters (GH, GL) in its set-up sheet.",
        "$extensions": { "dev.agentloops.dark": "#212121", "dev.agentloops.swift": "Paper.forgeMark" }
      },
      "fill": {
        "$description": "The same states as a filled badge with on-fill text on it: GitHub's darker fills, so the text reads.",
        "open": {
          "$value": "#1f883d",
          "$description": "An open badge; the merge button.",
          "$extensions": { "dev.agentloops.dark": "#238636", "dev.agentloops.swift": "Paper.forgeFillOpen" }
        },
        "done": {
          "$value": "#8250df",
          "$description": "A merged or closed badge.",
          "$extensions": { "dev.agentloops.dark": "#8957e5", "dev.agentloops.swift": "Paper.forgeFillDone" }
        },
        "closed": {
          "$value": "#cf222e",
          "$description": "A closed pull request's badge.",
          "$extensions": { "dev.agentloops.dark": "#da3633", "dev.agentloops.swift": "Paper.forgeFillClosed" }
        },
        "draft": {
          "$value": "#59636e",
          "$description": "A draft's or a not planned issue's badge.",
          "$extensions": { "dev.agentloops.dark": "#6e7681", "dev.agentloops.swift": "Paper.forgeFillDraft" }
        }
      }
    },
    "code": {
      "$description": "Code's inks by role (041), each 4.5:1 on the ground and the well, and none reads as red. Packages/CodeText's InkValues holds them for the window and the Remote.",
      "comment": {
        "$value": "#64707a",
        "$description": "A comment, in italic.",
        "$extensions": { "dev.agentloops.dark": "#a3adb8", "dev.agentloops.swift": "InkValues.comment" }
      },
      "keyword": {
        "$value": "#2b4c8c",
        "$description": "A keyword, true, false, null.",
        "$extensions": { "dev.agentloops.dark": "#8fb0e8", "dev.agentloops.swift": "InkValues.keyword" }
      },
      "string": {
        "$value": "#4e6420",
        "$description": "A string.",
        "$extensions": { "dev.agentloops.dark": "#a9c27a", "dev.agentloops.swift": "InkValues.string" }
      },
      "number": {
        "$value": "#7a3e7a",
        "$description": "A number.",
        "$extensions": { "dev.agentloops.dark": "#d5a3d5", "dev.agentloops.swift": "InkValues.number" }
      },
      "type": {
        "$value": "#1f6a6a",
        "$description": "A type.",
        "$extensions": { "dev.agentloops.dark": "#7cc4c0", "dev.agentloops.swift": "InkValues.type" }
      },
      "function": {
        "$value": "#5b4bb5",
        "$description": "A function.",
        "$extensions": { "dev.agentloops.dark": "#b3a6f0", "dev.agentloops.swift": "InkValues.function" }
      },
      "property": {
        "$value": "#52627a",
        "$description": "A property.",
        "$extensions": { "dev.agentloops.dark": "#bac5d7", "dev.agentloops.swift": "InkValues.property" }
      },
      "punctuation": {
        "$value": "#5e6470",
        "$description": "Punctuation and operators.",
        "$extensions": { "dev.agentloops.dark": "#a9b2bd", "dev.agentloops.swift": "InkValues.punctuation" }
      }
    },
    "timeline": {
      "$description": "Work ▸ Timeline (#4206): white by day, navy at night. WorkTimelineView.swift draws the same in Color(white:).",
      "plot": {
        "$value": "#ffffff",
        "$description": "The plot behind the lines.",
        "$extensions": { "dev.agentloops.dark": "#0d1429", "dev.agentloops.swift": "none: WorkTimelinePane.plot" }
      },
      "faint": {
        "$value": "#8c8c8c",
        "$description": "The axis's marks.",
        "$extensions": { "dev.agentloops.dark": "#999999", "dev.agentloops.swift": "none: WorkTimelinePane.faint" }
      },
      "trunk": {
        "$value": "#999999",
        "$description": "The trunk every feature leaves from.",
        "$extensions": { "dev.agentloops.dark": "#e7e8ea", "dev.agentloops.swift": "none: WorkTimelinePane's trunk" }
      },
      "release": {
        "$value": "#000000",
        "$description": "A release's ring on the trunk.",
        "$extensions": { "dev.agentloops.dark": "#ffffff", "dev.agentloops.swift": "none: WorkTimelinePane's release" }
      },
      "now": {
        "$value": "#8c8c8c",
        "$description": "The Now line.",
        "$extensions": { "dev.agentloops.dark": "#8c8c8c", "dev.agentloops.swift": "none: WorkTimelinePane.nowGrey" }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "control": {
      "$value": { "value": 7, "unit": "px" },
      "$description": "Chips, the rail, inputs.",
      "$extensions": { "dev.agentloops.swift": "Paper.Radius.control" }
    },
    "card": {
      "$value": { "value": 10, "unit": "px" },
      "$description": "Rows, wells, cards.",
      "$extensions": { "dev.agentloops.swift": "Paper.Radius.card" }
    },
    "floating": {
      "$value": { "value": 16, "unit": "px" },
      "$description": "Sheets, menus, the prompt bar (web)."
    }
  },
  "font": {
    "$type": "fontFamily",
    "text": {
      "$value": ["-apple-system", "BlinkMacSystemFont", "system-ui", "sans-serif"],
      "$description": "The system's sans-serif, for everything a person reads. Nothing is loaded from the network."
    },
    "mono": {
      "$value": ["ui-monospace", "SF Mono", "Menlo", "monospace"],
      "$description": "The system's monospace, for code."
    }
  },
  "type": {
    "$type": "dimension",
    "$description": "A step is a place on each platform's own scale: dev.agentloops.mac and dev.agentloops.ios are SwiftUI text styles (TypeScale.swift), the $value is the web's size.",
    "title": {
      "$value": { "value": 1.375, "unit": "rem" },
      "$description": "A page's title.",
      "$extensions": { "dev.agentloops.mac": ".title", "dev.agentloops.ios": ".title" }
    },
    "reading": {
      "$value": { "value": 1, "unit": "rem" },
      "$description": "Prose: what everything is read at unless there is a reason otherwise.",
      "$extensions": { "dev.agentloops.mac": ".title3", "dev.agentloops.ios": ".body" }
    },
    "supporting": {
      "$value": { "value": 0.875, "unit": "rem" },
      "$description": "A row's second line.",
      "$extensions": { "dev.agentloops.mac": ".body", "dev.agentloops.ios": ".subheadline" }
    },
    "fine": {
      "$value": { "value": 0.75, "unit": "rem" },
      "$description": "A timestamp, a count.",
      "$extensions": { "dev.agentloops.mac": ".subheadline", "dev.agentloops.ios": ".footnote" }
    },
    "code": {
      "$value": { "value": 0.875, "unit": "rem" },
      "$description": "Code, paths, commands, in the monospace.",
      "$extensions": { "dev.agentloops.mac": ".body", "dev.agentloops.ios": ".subheadline" }
    },
    "display": {
      "1": {
        "$value": "clamp(2rem, 5vw, 3.2rem)",
        "$description": "www's hero title."
      },
      "2": {
        "$value": { "value": 1.8, "unit": "rem" },
        "$description": "www's section titles."
      }
    }
  }
}
