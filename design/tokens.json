{
  "$description": "The design system's values (#4600, #4602): Paper, the app's look (#326, #695). One source. scripts/design.sh gen writes the CSS token files from it; DesignTokensTests says what to change in Shared/UI/Paper.swift, StateTint.swift, TypeScale.swift and the AccentColor assets. W3C Design Tokens shape: a colour's $value is its light value, and dev.agentloops.dark is its dark one.",
  "color": {
    "$type": "color",
    "ground": {
      "$value": "#fcfbf9",
      "$description": "The page every column sits on: near-white paper.",
      "$extensions": { "dev.agentloops.dark": "#1a1a19", "dev.agentloops.swift": "Paper.ground" }
    },
    "sidebar": {
      "$value": "#f8f7f4",
      "$description": "The folders column, one small step from the page; a rule sets it apart.",
      "$extensions": { "dev.agentloops.dark": "#171716", "dev.agentloops.swift": "Paper.sidebar" }
    },
    "raised": {
      "$value": "#ffffff",
      "$description": "Cards, the prompt bar, menus, sheets. Set apart by a rule, not a shadow.",
      "$extensions": { "dev.agentloops.dark": "#212120", "dev.agentloops.swift": "Paper.raised" }
    },
    "well": {
      "$value": "#f6f5f2",
      "$description": "What is set into the page: code, your own message, a filled field.",
      "$extensions": { "dev.agentloops.dark": "#262625", "dev.agentloops.swift": "Paper.well" }
    },
    "wash": {
      "$value": "#f1f0ec",
      "$description": "Hover; a pressed quiet button.",
      "$extensions": { "dev.agentloops.dark": "#2e2e2c", "dev.agentloops.swift": "Paper.wash" }
    },
    "rule": {
      "$value": "#d6d2c9",
      "$description": "The line that sets things apart, in place of a shadow (1.5:1): rows, cards, columns.",
      "$extensions": { "dev.agentloops.dark": "#3d3d3a", "dev.agentloops.swift": "Paper.rule" }
    },
    "edge": {
      "$value": "#7d786e",
      "$description": "The edge of a field, a checkbox, a toggle's track: 3:1 or more, so a control can be found (WCAG 1.4.11).",
      "$extensions": { "dev.agentloops.dark": "#85817a", "dev.agentloops.swift": "Paper.edge" }
    },
    "ink": {
      "$value": "#1a1918",
      "$description": "Text and icons: deep charcoal, 17:1 on the ground.",
      "$extensions": { "dev.agentloops.dark": "#f4f2ed", "dev.agentloops.swift": "Paper.ink" }
    },
    "secondary": {
      "$value": "#4a4741",
      "$description": "A row's second line, a speaker's name, a section heading.",
      "$extensions": { "dev.agentloops.dark": "#bdb9b0", "dev.agentloops.swift": "Paper.secondary" }
    },
    "tertiary": {
      "$value": "#625e57",
      "$description": "Timestamps, counts, placeholders.",
      "$extensions": { "dev.agentloops.dark": "#a29e95", "dev.agentloops.swift": "Paper.tertiary" }
    },
    "selection": {
      "$value": "#ebe9e4",
      "$description": "The picked row, with a 3px accent bar at its edge. Every text colour is 4.5:1 or more on it.",
      "$extensions": { "dev.agentloops.dark": "#363633", "dev.agentloops.swift": "Paper.selection" }
    },
    "accent": {
      "$value": "#1a52c0",
      "$description": "The app icon's cobalt: links, focus, the chosen control, a switch that is on.",
      "$extensions": { "dev.agentloops.dark": "#86b4ff", "dev.agentloops.swift": "AccentColor.colorset" }
    },
    "line": {
      "$description": "A state's line: a state shows its colour in its text, its icon and this line, never in a fill.",
      "accent": {
        "$value": "#a9c2ee",
        "$description": "The chosen thing, a link card.",
        "$extensions": { "dev.agentloops.dark": "#3d5687", "dev.agentloops.swift": "Paper.lineAccent" }
      },
      "attention": {
        "$value": "#e3d196",
        "$description": "Needs you: the yellow's line (#5016).",
        "$extensions": { "dev.agentloops.dark": "#615326", "dev.agentloops.swift": "Paper.lineAttention" }
      },
      "warning": {
        "$value": "#ebbf9f",
        "$description": "A warning: the orange's line (#5016).",
        "$extensions": { "dev.agentloops.dark": "#6b4a33", "dev.agentloops.swift": "Paper.lineWarning" }
      },
      "vouched": {
        "$value": "#a9d3bb",
        "$description": "Done, approved.",
        "$extensions": { "dev.agentloops.dark": "#36614d", "dev.agentloops.swift": "Paper.lineVouched" }
      },
      "failure": {
        "$value": "#eeb0b3",
        "$description": "Failed.",
        "$extensions": { "dev.agentloops.dark": "#6b3a3d", "dev.agentloops.swift": "Paper.lineFailure" }
      }
    },
