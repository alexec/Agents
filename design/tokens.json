        "$extensions": { "dev.agentloops.dark": "#e6c04f", "dev.agentloops.swift": "StateTint.yellow" }
      },
      "warning": {
        "$value": "#a3400e",
        "$description": "A warning: something is wrong or nearly so, and a person should know. Not a request (#5016).",
        "$extensions": { "dev.agentloops.dark": "#f3a672", "dev.agentloops.swift": "StateTint.orange" }
      },
      "failure": {
        "$value": "#b0222a",
        "$description": "Failed.",
        "$extensions": { "dev.agentloops.dark": "#f4878d", "dev.agentloops.swift": "StateTint.red" }
      },
      "vouched": {
        "$value": "#25684f",
        "$description": "Approved, done: an ending the app can vouch for.",
        "$extensions": { "dev.agentloops.dark": "#92ccad", "dev.agentloops.swift": "StateTint.green" }
      }
    },
    "label": {
      "issue": {
        "$value": "#0c6278",
        "$description": "A label naming an issue, #12.",
        "$extensions": { "dev.agentloops.dark": "#73cbe0", "dev.agentloops.swift": "Paper.issue" }
      },
      "pull": {
        "$value": "#6c3cae",
        "$description": "A label naming a pull request, P#12.",
        "$extensions": { "dev.agentloops.dark": "#bea3f2", "dev.agentloops.swift": "Paper.pull" }
      }
    },
    "on-fill": {
      "$value": "#ffffff",
