        "$extensions": { "dev.agentloops.dark": "#3fb950", "dev.agentloops.swift": "Paper.forgeOpen" }
      },
      "done": {
        "$value": "#8250df",
        "$description": "A closed issue, a merged pull request.",
        "$extensions": { "dev.agentloops.dark": "#a371f7", "dev.agentloops.swift": "Paper.forgeDone" }
      },
      "closed": {
        "$value": "#cf222e",
        "$description": "A pull request closed unmerged; a check that failed; changes asked for.",
        "$extensions": { "dev.agentloops.dark": "#f85149", "dev.agentloops.swift": "Paper.forgeClosed" }
      },
      "draft": {
        "$value": "#6e7781",
        "$description": "A draft, an issue not planned.",
        "$extensions": { "dev.agentloops.dark": "#8b949e", "dev.agentloops.swift": "Paper.forgeDraft" }
      },
      "waiting": {
        "$value": "#9a6700",
        "$description": "A check still running; an agent that waits on the person.",
        "$extensions": { "dev.agentloops.dark": "#d29922", "dev.agentloops.swift": "Paper.forgeWaiting" }
      },
      "waiting-wash": {
        "$value": "#fff8c5",
        "$description": "Under a notice in the forge's amber.",
        "$extensions": { "dev.agentloops.dark": "#2f2a1a", "dev.agentloops.swift": "Paper.forgeWaitingWash" }
      },
      "waiting-rule": {
        "$value": "#d4a72c",
        "$description": "The edge of a notice in the forge's amber.",
        "$extensions": { "dev.agentloops.dark": "#6b5a1e", "dev.agentloops.swift": "Paper.forgeWaitingRule" }
      },
      "mark": {
        "$value": "#212121",
        "$description": "The near-black disc under a connector's letters (GH, GL) in its set-up sheet.",
        "$extensions": { "dev.agentloops.dark": "#212121", "dev.agentloops.swift": "Paper.forgeMark" }
      },
      "fill": {
        "$description": "The same states as a filled badge with on-fill text on it: GitHub's darker fills, so the text reads.",
