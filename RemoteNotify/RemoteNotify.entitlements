<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 021 T069: the extension opens what was sealed to the app's key, so the two
	     share a keychain group and an app group. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.alexecollins.agents.shared</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.alexecollins.agents</string>
	</array>
</dict>
</plist>
