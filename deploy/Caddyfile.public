# The front door for a control plane on the internet (#61): a publicly trusted certificate
# for AGENTS_DOMAIN, and one for AGENTS_VIEWS_DOMAIN, the second name the web page's MCP Apps
# views are drawn at (#1484), from Let's Encrypt, renewed by Caddy on its own, and WebSockets
# passed through to the copy. Both names go to the same copy, which answers each with its own
# files. Codes carry no pin: see specs/research/public-certificate.md.
#
# Port 443 must be open for connections and for the certificate (TLS-ALPN), and port 80 too
# for Caddy's other challenge (HTTP-01) and its redirect to https. Behind Cloudflare's proxy
# (#2151), TLS-ALPN can't reach this Caddy, so Caddy falls back to HTTP-01 on its own.
{
	email {$ACME_EMAIL}
	admin off
	# Cloudflare's proxy (#2151) sits in front on agentloops.dev, orange-clouded in "Full
	# (strict)" mode, and the GCP firewall opens 80 and 443 to its ranges only
	# (deploy/gcp/up.sh --cloudflare). TLS-ALPN-01 can't reach this Caddy through the proxy
	# (Cloudflare terminates TLS itself), so the certificate renews over HTTP-01 instead; Caddy
	# falls back to it on its own, nothing to configure. The ranges below are Cloudflare's
	# published list (https://www.cloudflare.com/ips/), read as CF-Connecting-IP only from a
	# peer in them, so {http.request.remote.host} (and X-Forwarded-For below) is the real
	# visitor, never one a stranger sets. Harmless with no proxy in front: a direct peer is
	# never in these ranges, so Caddy falls back to the TCP peer's own address, as before.
	servers {
		trusted_proxies static \
 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 \
 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 \
 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 \
 2a06:98c0::/29 2c0f:f248::/32 {
			header CF-Connecting-IP
		}
	}
	# Settings for another ACME CA. None in production; compose.pebble.yaml mounts one here
	# for a walk with a stand-in CA.
	import /etc/caddy/acme.d/*.caddy
}

{$AGENTS_DOMAIN}, {$AGENTS_VIEWS_DOMAIN} {
	# Every request agents-control answers is a GET (the web page's files too, #1459), so no
	# body is ever big; a WebSocket's
	# frames past the upgrade are capped by agents-control itself (public-security.md P3).
	request_body {
		max_size 1MB
	}
	# Caddy writes X-Forwarded-For with the address it saw (its reverse_proxy default; the
	# trusted_proxies setting above resolves that address through Cloudflare when it fronts
	# this copy), and agents-control trusts the header from Caddy's address only
	# (AGENTS_CONTROL_TRUSTED_PROXIES in compose.public.yaml).
	reverse_proxy control:8791 {
		health_uri /readyz
		health_interval 5s
	}
}

# Our own sites, only where a file in deploy/site.d turns one on: on agentloops.dev's VM, the
# hand-back page for sign-ins (deploy/site/site.caddy, put there by deploy/gcp/site.sh, #1343).
# Elsewhere the folder is empty and this adds nothing.
import /etc/caddy/site.d/*.caddy
