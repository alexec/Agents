# The front door for a control plane on the internet (#61): a publicly trusted certificate
# for AGENTS_DOMAIN, and one for AGENTS_VIEWS_DOMAIN, the second name the web page's MCP Apps
# views are drawn at (#1484), from Let's Encrypt, renewed by Caddy on its own, and WebSockets
# passed through to the copy. Both names go to the same copy, which answers each with its own
# files. Codes carry no pin: see specs/research/public-certificate.md.
#
# Port 443 must be open for the certificate (TLS-ALPN), and port 80 too for Caddy's other
# challenge and its redirect to https.
{
	email {$ACME_EMAIL}
	admin off
	# Settings for another ACME CA. None in production; compose.pebble.yaml mounts one here
	# for a walk with a stand-in CA.
	import /etc/caddy/acme.d/*.caddy
}

{$AGENTS_DOMAIN}, {$AGENTS_VIEWS_DOMAIN} {
	# Every request agents-control answers is a GET (the web page's files too, #1459), so no
	# body is ever big; a WebSocket's
	# frames past the upgrade are capped by agents-control itself (public-security.md P3).
	request_body {
		max_size 1MB
	}
	# Caddy writes X-Forwarded-For with the address it saw, and agents-control trusts it
	# from Caddy's address only (AGENTS_CONTROL_TRUSTED_PROXIES in compose.public.yaml).
	reverse_proxy control:8791 {
		health_uri /readyz
		health_interval 5s
	}
}

# Our own sites, only where a file in deploy/site.d turns one on: on agentloops.dev's VM, the
# hand-back page for sign-ins (deploy/site/site.caddy, put there by deploy/gcp/site.sh, #1343).
# Elsewhere the folder is empty and this adds nothing.
import /etc/caddy/site.d/*.caddy
