<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Agents (#4224): the window and this Mac's host in one Developer ID app, not sandboxed:
     it runs agents, their tools and the control plane, so it is not in the App Store
     (058, R12). -->
<plist version="1.0">
<dict>
	<!-- This Mac's host, directly (#1118): agentsd's socket in the app group, which
	     agents-peer makes. Team-prefixed, so no provisioning profile names it. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>6T4RVD5724.com.alexecollins.agents</string>
	</array>
	<!-- Dictation and voice mode: the hardened runtime asks for the microphone. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
