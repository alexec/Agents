<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app group the App Store window shares with this Mac's host (#1118): agentsd
	     listens there for the window. scripts/go-agentsd.sh signs it in when it carries it. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>6T4RVD5724.com.alexecollins.agents</string>
	</array>
</dict>
</plist>
