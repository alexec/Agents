<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Added by dictation. The hardened runtime is on, and under it the microphone
	     is refused outright without this: macOS never asks, and the request comes
	     back denied. See specs/ for why dictation is here at all. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
