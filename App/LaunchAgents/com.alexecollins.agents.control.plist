<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The control plane on this Mac (058, R5): registered by Run one on this Mac with
     SMAppService, shown under Login Items as the app, kept running by launchd. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alexecollins.agents.control</string>
    <key>BundleProgram</key>
    <string>Contents/Helpers/agents-bridge.app/Contents/MacOS/agents-bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>agents-bridge</string>
        <string>--control-plane</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
