<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- This Mac's host (058, R5): the daemon that owns this Mac's agents, a host of the
     control plane at its ordinary root. It never leaves for being idle, and launchd
     starts it at login, so work on this Mac is picked up without opening the app. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alexecollins.agents.host</string>
    <key>BundleProgram</key>
    <string>Contents/Helpers/agentsd</string>
    <key>ProgramArguments</key>
    <array>
        <string>agentsd</string>
        <string>--control-home</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
