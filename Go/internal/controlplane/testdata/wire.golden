control/status
{
  "name": "Test plane",
  "version": "dev",
  "homeHost": "mac",
  "machineID": "MACHINE-1",
  "startedAt": <date>,
  "port": <port>,
  "you": "<UUID>",
  "folderDetection": {
    "enabled": true,
    "paths": [
      "~",
      "~/src",
      "~/code",
      "~/folders",
      "~/Developer",
      "~/dev",
      "~/git"
    ]
  },
  "capabilities": [
    "attention/1",
    "audit.sinks/1",
    "backups.store/1",
    "bots/1",
    "clients/1",
    "connections.botkey/1",
    "console/1",
    "control.connect-another/1",
    "control.rotate/1",
    "control/1",
    "events.audit/1",
    "events.team/1",
    "folders.to-machine/1",
    "folders/1",
    "git/1",
    "governance/1",
    "groups/1",
    "handover/1",
    "host.lock/1",
    "host.lock/2",
    "host.lock/4",
    "host.org-routes/2",
    "host.policy-layers/1",
    "host.policy/1",
    "host.secret-release/1",
    "host.suspend/1",
    "host.update/1",
    "host.user-settings/2",
    "host.web-pairing/1",
    "hosts.join/1",
    "links/1",
    "liveactivity/1",
    "lock-join/1",
    "lock-reset/1",
    "lock/1",
    "machine.accounts/1",
    "machine/1",
    "machines/1",
    "multiplier/1",
    "notices/1",
    "org-identity/1",
    "org-routes/2",
    "people/1",
    "policy.ask/1",
    "policy/1",
    "projects.boards/1",
    "projects.sessions/1",
    "projects/1",
    "providers/1",
    "readapi/1",
    "reports.nodes/1",
    "reports.scope/1",
    "reports.value/1",
    "reports.views/1",
    "reports/1",
    "sealing/1",
    "sessions.elsewhere/1",
    "sessions.on-machine/1",
    "sessions.project/1",
    "signin.ask/1",
    "signin/1",
    "summary.machines/1",
    "tunnel/1",
    "user/1",
    "user/2",
    "user/3"
  ],
  "required": {
    "host": [
      "host.wire/1"
    ],
    "client": [
      "client.wire/1"
    ]
  },
  "person": {
    "id": "<uuid>",
    "name": "Local owner",
    "role": "admin",
    "localOwner": true
  },
  "joinCommand": "curl -fsSL <url>/v1/install.sh | sh -s -- --join '<url>' '-' '<uuid>'"
}

