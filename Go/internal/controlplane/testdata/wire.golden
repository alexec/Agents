clients/setGrant refused
{
  "code": -32009,
  "message": "Every paired client may do everything now, so there is no grant to change. Update this window to lose the choice."
}

machines/remove refused
{
  "code": -32091,
  "message": "No machine is called nobody."
}

machines/update refused
{
  "code": -32091,
  "message": "There is no such host."
}

providers/list refused
{
  "code": -32064,
  "message": "Machine providers are off on this control plane, because it has no folder for their secrets (AGENTS_CONTROL_PROVIDER_HOME)."
}

