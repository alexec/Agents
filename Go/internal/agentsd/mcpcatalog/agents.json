{
  "servers": [
    {
      "server": {
        "name": "agents/github",
        "title": "GitHub",
        "description": "Issues, pull requests and Actions: the official GitHub MCP server's tools, and events"
      },
      "_meta": {
        "dev.agentloops/connector": {
          "command": "github-mcp",
          "hosted": true,
          "declares": {
            "tools": true,
            "events": [
              "checks.failed",
              "checks.passed",
              "run.completed",
              "pr.opened",
              "pr.merged",
              "pr.closed",
              "pr.conflicted",
              "pr.commented",
              "review.requested",
              "review.posted",
              "review.comment",
              "pr.labelled",
              "pr.unlabelled",
              "issue.opened",
              "issue.labelled",
              "issue.commented",
              "issue.closed",
              "issue.assigned"
            ],
            "views": true
          },
          "tested": "2026-10-19"
        }
      }
    },
    {
      "server": {
        "name": "agents/linear",
        "title": "Linear",
        "description": "Linear issues: a page of open issues with Start Agent, and events when one is opened, labelled, commented on or closed"
      },
      "_meta": {
        "dev.agentloops/connector": {
          "command": "linear-mcp",
          "hosted": true,
          "declares": {
            "tools": true,
            "events": [
              "issue.opened",
              "issue.labelled",
              "issue.commented",
              "issue.closed",
              "issue.assigned"
            ],
            "views": true
          },
          "tested": "2026-10-19"
        }
      }
    },
    {
      "server": {
        "name": "agents/jira",
        "title": "Jira",
        "description": "Jira issues on Jira Cloud or Data Center: a page of open issues with Start Agent, and events when one is opened, labelled, commented on or assigned to you"
      },
      "_meta": {
        "dev.agentloops/connector": {
          "command": "jira-mcp",
          "hosted": true,
          "declares": {
            "tools": true,
            "events": [
              "issue.opened",
              "issue.labelled",
              "issue.commented",
              "issue.assigned"
            ],
            "views": true
          }
        }
      }
    },
    {
      "server": {
        "name": "agents/gitlab",
        "title": "GitLab",
        "description": "Merge requests, pipelines and issues on gitlab.com or a self-managed GitLab: their pages, tools to read them and comment, and events"
      },
      "_meta": {
        "dev.agentloops/connector": {
          "command": "gitlab-mcp",
          "hosted": true,
          "declares": {
            "tools": true,
            "events": [
              "checks.failed",
              "pr.opened",
              "pr.merged",
              "pr.closed",
              "pr.conflicted",
              "review.requested",
              "review.comment",
              "issue.opened",
              "issue.labelled",
              "issue.commented",
              "issue.closed",
              "issue.assigned"
            ],
            "views": true
          },
          "tested": "2026-10-20"
        }
      }
    },
    {
      "server": {
        "name": "agents/email",
        "title": "Email",
        "description": "One mailbox over IMAP: an event when mail comes, a Mail page, and tools to list, search and read it, mark it read and move it. It never sends mail"
      },
      "_meta": {
        "dev.agentloops/connector": {
          "command": "email-mcp",
          "hosted": true,
          "declares": {
            "tools": true,
            "events": [
              "email.received"
            ],
            "views": true
          }
        }
      }
    },
    {
      "server": {
        "name": "agents/slack",
        "title": "Slack",
        "description": "One Slack workspace, as your Slack app's bot over Socket Mode: events when a message comes or a question is answered, and tools to list channels, read messages, send a message and ask a question with buttons"
      },
      "_meta": {
        "dev.agentloops/connector": {
          "command": "slack-mcp",
          "hosted": true,
          "secrets": [
            {
              "name": "SLACK_BOT_TOKEN",
              "description": "The Slack app's Bot User OAuth Token, xoxb-…",
              "required": true
            },
            {
              "name": "SLACK_APP_TOKEN",
              "description": "An app-level token with connections:write, xapp-…",
              "required": true
            }
          ],
          "declares": {
            "tools": true,
            "events": [
              "message.received",
              "question.answered"
            ],
            "views": false
          }
        }
      }
    }
  ]
}
